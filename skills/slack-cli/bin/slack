#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["requests"]
# ///
"""Thin Slack Web API CLI using xoxp from macOS Keychain.

Subcommands: mentions, dms, history, thread, reply, send, search, channels,
users, react, file, raw, whoami.

Reads render as clean, resolved, low-noise text by default (names, @-mentions,
local timestamps, reaction/file/thread summaries). Pass --json for raw API
responses; --no-resolve to skip name lookups on big pulls.
"""

from __future__ import annotations

import argparse
import atexit
import datetime
import html
import json
import os
import re
import subprocess
import sys
import time
from typing import Any
from zoneinfo import ZoneInfo

import requests

API = "https://slack.com/api"
KEYCHAIN_ACCOUNT = os.environ["USER"]
KEYCHAIN_SERVICE = "slack-xoxp"
SELF_AUTH_CACHE: dict | None = None           # full auth.test (user_id + workspace url)
SELF_TZ_CACHE: datetime.tzinfo | None = None
USER_CACHE: dict[str, tuple[str, str]] = {}   # user_id    -> (handle, real_name)
USER_EMAIL: dict[str, str] = {}               # user_id    -> email (when known)
CHANNEL_CACHE: dict[str, str] = {}            # channel_id -> name
USER_BY_NAME: dict[str, str] = {}             # handle/real (lower) -> user_id
CHANNEL_BY_NAME: dict[str, str] = {}          # name (lower)        -> channel_id
RESOLVE: bool = True                          # output labeling; set from --no-resolve
_CACHE_DIRTY: bool = False                    # persist on exit only if we learned anything


# --- auth ----------------------------------------------------------------

def get_token() -> str:
    if (env := os.environ.get("SLACK_XOXP")):
        return env
    out = subprocess.run(
        ["security", "find-generic-password", "-a", KEYCHAIN_ACCOUNT, "-s", KEYCHAIN_SERVICE, "-w"],
        check=True, capture_output=True, text=True,
    )
    return out.stdout.strip()


_session: requests.Session | None = None


def session() -> requests.Session:
    global _session
    if _session is None:
        _session = requests.Session()
        _session.headers["Authorization"] = f"Bearer {get_token()}"
    return _session


def _request(method: str, *, params: dict | None = None, json_body: dict | None = None) -> dict:
    url = f"{API}/{method}"
    for attempt in range(5):
        if json_body is not None:
            r = session().post(url, json=json_body, headers={"Content-Type": "application/json; charset=utf-8"})
        else:
            r = session().get(url, params=params or {})
        if r.status_code != 429:
            break
        # Slack rate limit: honour Retry-After, back off a little extra each try.
        wait = int(r.headers.get("Retry-After", "30")) + attempt
        print(f"rate limited on {method}, sleeping {wait}s", file=sys.stderr)
        time.sleep(wait)
    r.raise_for_status()
    return r.json()


def call(method: str, *, params: dict | None = None, json_body: dict | None = None) -> dict:
    data = _request(method, params=params, json_body=json_body)
    if not data.get("ok"):
        raise SystemExit(f"slack api error: {method}: {data.get('error')} (warn={data.get('warning')})")
    return data


def try_call(method: str, *, params: dict | None = None, json_body: dict | None = None) -> tuple[bool, dict]:
    """Like call(), but returns (ok, data) instead of exiting on a Slack-level error.

    For callers that want to branch on a specific `error` -- or, as in cmd_dms,
    skip a single unusable item rather than abort the whole listing. Transport
    errors and rate limiting are handled identically to call().
    """
    data = _request(method, params=params, json_body=json_body)
    return bool(data.get("ok")), data


def auth_info() -> dict:
    global SELF_AUTH_CACHE
    if SELF_AUTH_CACHE is None:
        SELF_AUTH_CACHE = call("auth.test")
    return SELF_AUTH_CACHE


def me() -> str:
    return auth_info()["user_id"]


def workspace_url() -> str:
    """Workspace base URL with trailing slash, e.g. https://<workspace>.slack.com/."""
    return auth_info().get("url", "")


# --- persistent resolution cache -----------------------------------------

def _cache_dir() -> str:
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(base, "slack-cli")


def mark_dirty() -> None:
    global _CACHE_DIRTY
    _CACHE_DIRTY = True


def index_user(uid: str, handle: str, real: str, email: str | None = None) -> None:
    USER_CACHE[uid] = (handle, real)
    if handle:
        USER_BY_NAME.setdefault(handle.lower(), uid)
    if real:
        USER_BY_NAME.setdefault(real.lower(), uid)
    if email:
        USER_EMAIL[uid] = email
    mark_dirty()


def index_channel(cid: str, name: str) -> None:
    CHANNEL_CACHE[cid] = name
    if name and name != cid:
        CHANNEL_BY_NAME.setdefault(name.lower(), cid)
    mark_dirty()


def load_caches() -> None:
    """Load persisted user/channel maps (best-effort) so resolution survives runs."""
    d = _cache_dir()
    try:
        with open(os.path.join(d, "users.json")) as f:
            for uid, v in json.load(f).items():
                USER_CACHE[uid] = (v["handle"], v["real"])
                if v.get("email"):
                    USER_EMAIL[uid] = v["email"]
                USER_BY_NAME.setdefault(v["handle"].lower(), uid)
                USER_BY_NAME.setdefault(v["real"].lower(), uid)
    except (OSError, ValueError, KeyError):
        pass
    try:
        with open(os.path.join(d, "channels.json")) as f:
            for cid, name in json.load(f).items():
                CHANNEL_CACHE[cid] = name
                CHANNEL_BY_NAME.setdefault(name.lower(), cid)
    except (OSError, ValueError):
        pass


def save_caches() -> None:
    if not _CACHE_DIRTY:
        return
    d = _cache_dir()
    try:
        os.makedirs(d, exist_ok=True)
        users = {
            uid: {"handle": h, "real": r, **({"email": USER_EMAIL[uid]} if uid in USER_EMAIL else {})}
            for uid, (h, r) in USER_CACHE.items()
            if not (h == uid and r == uid)  # drop failure sentinels
        }
        with open(os.path.join(d, "users.json"), "w") as f:
            json.dump(users, f)
        chans = {cid: n for cid, n in CHANNEL_CACHE.items() if n != cid}
        with open(os.path.join(d, "channels.json"), "w") as f:
            json.dump(chans, f)
    except OSError:
        pass


# --- resolution (users, channels, mentions) ------------------------------

def user_name(uid: str) -> tuple[str, str]:
    """(handle, real_name) for a user id. RESOLVE-first so --no-resolve stays raw."""
    if not RESOLVE:
        return (uid, uid)
    if uid in USER_CACHE:
        return USER_CACHE[uid]
    try:
        u = call("users.info", params={"user": uid})["user"]
        prof = u.get("profile", {})
        handle = u.get("name") or uid
        real = prof.get("real_name") or prof.get("display_name") or u.get("real_name") or handle
        index_user(uid, handle, real, prof.get("email"))
    except SystemExit:
        USER_CACHE[uid] = (uid, uid)  # deleted/inaccessible — not indexed, not persisted
    return USER_CACHE[uid]


def channel_name(cid: str) -> str:
    if not RESOLVE:
        return cid
    if cid in CHANNEL_CACHE:
        return CHANNEL_CACHE[cid]
    try:
        c = call("conversations.info", params={"channel": cid})["channel"]
        index_channel(cid, c.get("name") or cid)
    except SystemExit:
        CHANNEL_CACHE[cid] = cid
    return CHANNEL_CACHE[cid]


def warm_users() -> None:
    """Bulk-fill the user cache via one tier-2 users.list walk (vs N tier-3 lookups)."""
    cursor = ""
    while True:
        p: dict[str, Any] = {"limit": 200}
        if cursor:
            p["cursor"] = cursor
        data = call("users.list", params=p)
        for u in data.get("members", []):
            prof = u.get("profile", {})
            index_user(
                u["id"],
                u.get("name") or u["id"],
                prof.get("real_name") or prof.get("display_name") or u.get("real_name") or u["id"],
                prof.get("email"),
            )
        cursor = data.get("response_metadata", {}).get("next_cursor", "")
        if not cursor:
            break


def list_channels(types: str) -> list[dict]:
    """List all conversations of the given types (paged) and index their names."""
    out: list[dict] = []
    cursor = ""
    while True:
        p: dict[str, Any] = {"types": types, "limit": 1000, "exclude_archived": "true"}
        if cursor:
            p["cursor"] = cursor
        data = call("conversations.list", params=p)
        out.extend(data.get("channels", []))
        cursor = data.get("response_metadata", {}).get("next_cursor", "")
        if not cursor:
            break
    for c in out:
        if c.get("name"):
            index_channel(c["id"], c["name"])
    return out


def ensure_users_loaded() -> None:
    if len(USER_CACHE) < 50:  # cold (empty disk cache) — one bulk walk
        warm_users()


def ensure_channels_loaded() -> None:
    if not CHANNEL_BY_NAME:
        list_channels("public_channel,private_channel")


_ID_RE = re.compile(r"[CDGUW][A-Z0-9]{6,}")


def resolve_user(arg: str) -> str:
    """'@name' / 'Real Name' / 'U123' -> user id."""
    s = arg.lstrip("@")
    if _ID_RE.fullmatch(s):
        return s
    ensure_users_loaded()
    uid = USER_BY_NAME.get(s.lower())
    if not uid:
        raise SystemExit(f"unknown user: {arg!r} (try `slack users {s}`)")
    return uid


def resolve_channel(arg: str) -> str:
    """'#channel' / 'channel' / '@user' / id -> channel-or-user id (always, ignores RESOLVE)."""
    if arg.startswith("@"):
        return resolve_user(arg)
    if _ID_RE.fullmatch(arg):
        return arg
    name = arg.lstrip("#").lower()
    if name in CHANNEL_BY_NAME:
        return CHANNEL_BY_NAME[name]
    ensure_channels_loaded()
    if name in CHANNEL_BY_NAME:
        return CHANNEL_BY_NAME[name]
    raise SystemExit(f"unknown channel: {arg!r} (try `slack channels`)")


_MENTION_RE = re.compile(r"<(.*?)>")


def resolve_mentions(text: str) -> str:
    """Substitute Slack mrkdwn entities (<@U…>, <#C…>, links) then unescape HTML."""
    if not text:
        return text

    def repl(m: re.Match[str]) -> str:
        body = m.group(1)
        if body.startswith("@"):  # user: <@U123> or <@U123|fallback>
            uid = body[1:].split("|", 1)[0]
            if uid.startswith(("U", "W")):
                return f"@{user_name(uid)[1]}"
            return f"@{body[1:]}"
        if body.startswith("#"):  # channel: <#C123|label> or <#C123>
            inner = body[1:]
            if "|" in inner:
                cid, label = inner.split("|", 1)
                return f"#{label or channel_name(cid)}"
            return f"#{channel_name(inner)}"
        if body.startswith("!subteam^"):  # user-group: <!subteam^S123|@group>
            rest = body.split("|", 1)
            return rest[1] if len(rest) > 1 else "@group"
        if body.startswith("!"):  # <!here>, <!channel>, <!date^…|fallback>
            inner = body[1:]
            if "|" in inner:
                return inner.split("|", 1)[1]
            return "@" + inner.split("^", 1)[0]
        if "|" in body:  # link: <https://x|label>, <mailto:a@b|a@b>
            url, label = body.split("|", 1)
            return label or url
        return body

    return html.unescape(_MENTION_RE.sub(repl, text))


# --- formatting helpers --------------------------------------------------

def relative_age(ts: str | float) -> str:
    d = int(time.time() - float(ts))
    if d < 60:
        return f"{d}s"
    if d < 3600:
        return f"{d // 60}m"
    if d < 86400:
        return f"{d // 3600}h"
    return f"{d // 86400}d"


def self_tz() -> datetime.tzinfo:
    """Token owner's Slack-profile timezone (cached). Local TZ fallback."""
    global SELF_TZ_CACHE
    if SELF_TZ_CACHE is None:
        try:
            u = call("users.info", params={"user": me()})["user"]
            prof = u.get("profile", {})
            if RESOLVE and me() not in USER_CACHE:  # seed self while we have the payload
                index_user(me(), u.get("name") or me(),
                           prof.get("real_name") or prof.get("display_name") or me(), prof.get("email"))
            tzname = u.get("tz")
            if tzname:
                SELF_TZ_CACHE = ZoneInfo(tzname)
            else:
                SELF_TZ_CACHE = datetime.timezone(datetime.timedelta(seconds=u.get("tz_offset", 0)))
        except Exception:
            SELF_TZ_CACHE = datetime.datetime.now().astimezone().tzinfo or datetime.timezone.utc
    return SELF_TZ_CACHE


def fmt_time(ts: str | float) -> str:
    """Compact local time + relative age, e.g. 'Jun 11 14:32 (2h)'."""
    dt = datetime.datetime.fromtimestamp(float(ts), self_tz())
    stamp = dt.strftime("%b %e %H:%M").replace("  ", " ")
    return f"{stamp} ({relative_age(ts)})"


def truncate(s: str, n: int) -> str:
    s = re.sub(r"\s+", " ", s).strip()
    return s if len(s) <= n else s[: n - 1] + "…"


_DUR_RE = re.compile(r"^(\d+)\s*([mhdw])$")
_DUR_SECS = {"m": 60, "h": 3600, "d": 86400, "w": 604800}


def parse_duration(s: str) -> int:
    """'30m' / '12h' / '2d' / '1w' -> seconds."""
    m = _DUR_RE.match(s.strip().lower())
    if not m:
        raise SystemExit(f"bad duration: {s!r} (use e.g. 30m, 12h, 2d, 1w)")
    return int(m.group(1)) * _DUR_SECS[m.group(2)]


def permalink(channel: str, ts: str) -> str:
    base = workspace_url()
    if not base or not channel:
        return ""
    return f"{base}archives/{channel}/p{ts.replace('.', '')}"


def print_table(rows: list[list[str]]) -> None:
    """Print rows aligned by column. First col always row index [N]."""
    if not rows:
        print("(no rows)")
        return
    cols = max(len(r) for r in rows)
    widths = [0] * cols
    for r in rows:
        for i, cell in enumerate(r):
            widths[i] = max(widths[i], len(cell))
    for r in rows:
        line = "  ".join(cell.ljust(widths[i]) for i, cell in enumerate(r) if i < cols - 1)
        last = r[-1] if r else ""
        print(f"{line}  {last}".rstrip() if line else last)


# --- message formatter (history / thread) --------------------------------

_SYSTEM_SUBTYPES = {"channel_join", "channel_leave", "channel_topic",
                    "channel_purpose", "channel_name"}


def is_activity(m: dict) -> bool:
    return m.get("subtype") in _SYSTEM_SUBTYPES


def summarize_reactions(m: dict) -> str:
    rs = m.get("reactions") or []
    return "  ".join(f":{r['name']}: {r['count']}" for r in rs)


def summarize_files(m: dict) -> str:
    fs = m.get("files") or []
    if not fs:
        return ""
    names = [f.get("name") or f.get("title") or f.get("id", "file") for f in fs]
    shown = ", ".join(names[:3]) + ("…" if len(names) > 3 else "")
    return f"📎 {len(fs)} file(s): {shown}"


def summarize_thread(m: dict) -> str:
    rc = m.get("reply_count")
    if not rc:
        return ""
    who = f", {m['reply_users_count']} people" if m.get("reply_users_count") else ""
    tail = f", latest {relative_age(m['latest_reply'])} ago" if m.get("latest_reply") else ""
    return f"↳ Thread: {rc} repl{'y' if rc == 1 else 'ies'}{who}{tail}"


def author_label(m: dict) -> str:
    if m.get("user"):
        handle, real = user_name(m["user"])
        return real if real == handle else f"{real} (@{handle})"
    if m.get("bot_profile"):
        return f"{m['bot_profile'].get('name', 'bot')} [bot]"
    if m.get("username"):
        return f"{m['username']} [bot]"
    if m.get("bot_id"):
        return f"{m['bot_id']} [bot]"
    return "?"


def format_message(m: dict, *, show_thread: bool = True,
                   channel: str | None = None, links: bool = False) -> str:
    head = f"[{m['ts']}] {author_label(m)} · {fmt_time(m['ts'])}"
    subtype = m.get("subtype")
    if subtype in _SYSTEM_SUBTYPES:
        return head + f"  ({subtype.replace('channel_', '')})"
    text = resolve_mentions(m.get("text", ""))
    text = re.sub(r"[ \t]+\n", "\n", text).strip()
    parts = [head]
    if text:
        parts.append(text)
    meta = []
    if (rx := summarize_reactions(m)):
        meta.append(rx)
    if (fl := summarize_files(m)):
        meta.append(fl)
    if show_thread and (th := summarize_thread(m)):
        meta.append(th)
    if meta:
        parts.append("  ".join(meta))
    if links and channel:
        parts.append(f"↗ {permalink(channel, m['ts'])}")
    return "\n".join(parts)


# --- subcommand: mentions -----------------------------------------------

def cmd_mentions(args: argparse.Namespace) -> None:
    data = call(
        "search.messages",
        params={
            "query": f"<@{me()}>",
            "sort": "timestamp",
            "sort_dir": "desc",
            "count": args.n,
        },
    )
    if args.json:
        print(json.dumps(data, indent=2))
        return
    matches = data["messages"]["matches"]
    rows = []
    for i, m in enumerate(matches, 1):
        rows.append([
            f"[{i}]",
            relative_age(m["ts"]),
            f"#{m['channel']['name']}",
            f"@{m.get('username', '?')}",
            truncate(resolve_mentions(m.get("text", "")), 110),
            m.get("permalink", ""),
        ])
    print_table(rows)


# --- subcommand: dms -----------------------------------------------------

def cmd_dms(args: argparse.Namespace) -> None:
    global RESOLVE
    RESOLVE = not getattr(args, "no_resolve", False)
    types = "im,mpim" if args.group else "im"
    chans = call(
        "users.conversations",
        params={"types": types, "limit": 100, "exclude_archived": "true"},
    )["channels"]

    rows_raw: list[dict[str, Any]] = []
    for c in chans:
        # Slack lists the Slackbot DM in users.conversations but rejects it from
        # every Conversations read method with channel_not_found; a deactivated
        # peer or a revoked shared-channel grant does the same. call() would exit
        # here, so one unreadable DM took out the entire listing before it
        # printed a single row. A DM that cannot be read has no row to print.
        ok, h = try_call("conversations.history", params={"channel": c["id"], "limit": 1})
        if not ok:
            continue
        msgs = h.get("messages") or []
        if not msgs:
            continue
        m = msgs[0]
        ts = float(m["ts"])
        if c.get("is_im"):
            peer = user_name(c["user"])[1]
        else:
            peer = c.get("name") or "(group)"
        from_id = m.get("user") or m.get("bot_id") or "?"
        direction = "me" if from_id == me() else "them"
        rows_raw.append({
            "ts": m["ts"],
            "channel_id": c["id"],
            "user_id": c.get("user"),  # the peer's U… (im only); None for group
            "peer": peer,
            "dir": direction,
            "text": m.get("text", ""),
        })

    rows_raw.sort(key=lambda r: float(r["ts"]), reverse=True)
    rows_raw = rows_raw[: args.n]

    if args.json:
        # channel_id is reply-ready: `slack reply <channel_id> <ts> --text-file -`
        print(json.dumps(rows_raw, indent=2))
        return

    rows = []
    for i, r in enumerate(rows_raw, 1):
        rows.append([
            f"[{i}]",
            relative_age(r["ts"]),
            r["peer"],
            f"({r['dir']})",
            truncate(resolve_mentions(r["text"]), 110),
        ])
    print_table(rows)


# --- subcommand: history -------------------------------------------------

def cmd_history(args: argparse.Namespace) -> None:
    global RESOLVE
    RESOLVE = not args.no_resolve
    if args.warm and RESOLVE:
        warm_users()
    channel = resolve_channel(args.channel)
    limit = args.n
    params: dict[str, Any] = {"channel": channel, "limit": limit}
    if args.since:
        params["oldest"] = f"{time.time() - parse_duration(args.since):.6f}"
        params["limit"] = max(limit, 200)
    if args.cursor:
        params["cursor"] = args.cursor
    data = call("conversations.history", params=params)
    if args.json:
        print(json.dumps(data, indent=2))
        return
    header = f"#{channel_name(channel)}" if RESOLVE else channel
    print(f"# {header}\n")
    for m in data.get("messages", []):
        if is_activity(m) and not args.activity:
            continue
        print(format_message(m, show_thread=True, channel=channel, links=args.links))
        print()
    cur = data.get("response_metadata", {}).get("next_cursor")
    if data.get("has_more") and cur:
        print(f"next: --cursor {cur}")


# --- subcommand: thread --------------------------------------------------

def cmd_thread(args: argparse.Namespace) -> None:
    global RESOLVE
    RESOLVE = not args.no_resolve
    if args.warm and RESOLVE:
        warm_users()
    channel = resolve_channel(args.channel)
    params: dict[str, Any] = {"channel": channel, "ts": args.ts, "limit": args.n}
    if args.since:
        params["oldest"] = f"{time.time() - parse_duration(args.since):.6f}"
    if args.cursor:
        params["cursor"] = args.cursor
    data = call("conversations.replies", params=params)
    if args.json:
        print(json.dumps(data, indent=2))
        return
    for m in data.get("messages", []):
        if is_activity(m) and not args.activity:
            continue
        print(format_message(m, show_thread=False, channel=channel, links=args.links))
        print()
    cur = data.get("response_metadata", {}).get("next_cursor")
    if data.get("has_more") and cur:
        print(f"next: --cursor {cur}")


# --- subcommand: reply / send -------------------------------------------

# CommonMark markers that Slack renders literally (it uses mrkdwn, not CommonMark).
# Used to (a) drive the markdown_to_mrkdwn conversion and (b) guard the raw escape
# hatch — see looks_like_markdown / cmd_raw.
_MD_LINK = re.compile(r"\[([^\]]+)\]\(\s*<?([^()\s<>]+(?:\([^()\s<>]*\)[^()\s<>]*)*)>?\s*\)")


def looks_like_markdown(text: str) -> list[str]:
    """Return the CommonMark markers found in `text` that Slack would render
    literally (`**bold**`, `__bold__`, `[label](url)`, `# heading`). Code spans
    and fences are stripped first so code samples don't trip it. Empty list ⇒ safe
    to send verbatim. Drives the `slack raw chat.*` guardrail and the `--raw` warning.
    """
    if not text:
        return []
    probe = re.sub(r"```.*?```", "", text, flags=re.DOTALL)
    probe = re.sub(r"`[^`\n]+`", "", probe)
    found: list[str] = []
    if re.search(r"\*\*.+?\*\*", probe, flags=re.DOTALL):
        found.append("**bold**")
    if re.search(r"(?<!\w)__.+?__(?!\w)", probe, flags=re.DOTALL):
        found.append("__bold__")
    if _MD_LINK.search(probe):
        found.append("[label](url)")
    if re.search(r"(?m)^[ \t]*#{1,6}[ \t]+\S", probe):
        found.append("# heading")
    return found


def markdown_to_mrkdwn(text: str) -> str:
    """Convert common Markdown to Slack mrkdwn.

    Slack does NOT use CommonMark: bold is *one* star (not `**`), italic is
    `_underscore_`, links are `<url|label>`, no headings. Agents write Markdown,
    so `**bold**` would otherwise render with literal asterisks. Code spans and
    link URLs are protected; pass --raw to skip this and send verbatim Slack mrkdwn.

    NOT idempotent — re-running over mrkdwn corrupts it (`*bold*` -> `_bold_`).
    Convert once, on the way out (cmd_send), never re-feed mrkdwn through it.
    """
    if not text:
        return text
    blocks: list[str] = []

    def stash(m: re.Match[str]) -> str:
        blocks.append(m.group(0))
        return f"\x00{len(blocks) - 1}\x00"

    def stash_str(s: str) -> str:
        blocks.append(s)
        return f"\x00{len(blocks) - 1}\x00"

    def link(m: re.Match[str]) -> str:
        # [label](url) -> <url|label>. The URL is stashed (so a later bold/italic
        # pass can't touch a `*`/`_` inside it) and any literal `|` is percent-
        # encoded, since Slack splits <url|label> at the FIRST pipe. The label is
        # left live so markdown inside it still converts.
        url = m.group(2).replace("|", "%7C")
        return f"<{stash_str(url)}|{m.group(1)}>"

    text = re.sub(r"```.*?```", stash, text, flags=re.DOTALL)   # fenced code
    text = re.sub(r"`[^`\n]+`", stash, text)                    # inline code
    text = _MD_LINK.sub(link, text)                             # [label](url) -> <url|label>
    BOLD, ITAL = "\x01", "\x02"
    text = re.sub(r"(?m)^#{1,6}[ \t]+(.+?)[ \t]*#*$",
                  lambda m: f"{BOLD}{m.group(1)}{BOLD}", text)   # heading -> bold line
    text = re.sub(r"(?m)^([ \t]*)[-+][ \t]+", r"\1• ", text)    # - / + bullets -> •
    text = re.sub(r"\*\*\*(.+?)\*\*\*",
                  lambda m: f"{BOLD}{ITAL}{m.group(1)}{ITAL}{BOLD}", text, flags=re.DOTALL)
    text = re.sub(r"\*\*(.+?)\*\*", lambda m: f"{BOLD}{m.group(1)}{BOLD}", text, flags=re.DOTALL)
    text = re.sub(r"__(.+?)__", lambda m: f"{BOLD}{m.group(1)}{BOLD}", text, flags=re.DOTALL)
    text = re.sub(r"(?<![\w*])\*(?!\s)(.+?)(?<!\s)\*(?![\w*])",
                  lambda m: f"{ITAL}{m.group(1)}{ITAL}", text)   # *italic* -> _italic_
    text = re.sub(r"~~(.+?)~~", r"~\1~", text, flags=re.DOTALL)  # ~~strike~~ -> ~strike~
    text = text.replace(BOLD, "*").replace(ITAL, "_")
    text = re.sub(r"\x00(\d+)\x00", lambda m: blocks[int(m.group(1))], text)
    return text


# Special broadcast mentions: @here/@channel/@everyone -> <!here> etc.
_BROADCAST = {"here": "<!here>", "channel": "<!channel>", "everyone": "<!everyone>"}
# Match @handle or @"Full Name" only when @ starts a word (not mid-email like a@b.com).
_OUT_MENTION = re.compile(r'(?<![\w@./])@(?:"([^"\n]+)"|([A-Za-z0-9][A-Za-z0-9._-]*))')


def resolve_outbound_mentions(text: str) -> str:
    """`@handle` / `@"Full Name"` -> `<@Uid>` so the mention actually pings.

    EXACT match only (handle or full real-name, case-insensitive) against the
    user cache — `@here/@channel/@everyone` become broadcast entities. An
    ambiguous or unknown token (e.g. `@Taylor` when 7 people match) is left as
    literal text with a stderr warning: a non-ping is better than a mis-ping.
    Code spans/fences are protected so `@x` inside them never resolves.
    """
    if not text or not RESOLVE:
        return text
    blocks: list[str] = []

    def stash(m: re.Match[str]) -> str:
        blocks.append(m.group(0))
        return f"\x00{len(blocks) - 1}\x00"

    tmp = re.sub(r"```.*?```", stash, text, flags=re.DOTALL)  # fenced code
    tmp = re.sub(r"`[^`\n]+`", stash, tmp)                    # inline code
    ensure_users_loaded()

    def repl(m: re.Match[str]) -> str:
        name = m.group(1) or m.group(2)
        if name.lower() in _BROADCAST:
            return _BROADCAST[name.lower()]
        uid = USER_BY_NAME.get(name.lower())
        if uid:
            return f"<@{uid}>"
        print(f"warning: @{name} did not resolve to a unique user — left as text, "
              f"no ping. Use the exact handle (`slack users {name}`) or <@ID>.",
              file=sys.stderr)
        return m.group(0)

    tmp = _OUT_MENTION.sub(repl, tmp)
    return re.sub(r"\x00(\d+)\x00", lambda m: blocks[int(m.group(1))], tmp)


def resolve_text(args: argparse.Namespace, required: bool = True) -> str:
    """Message body from --text-file (path, or '-' for stdin) or the positional arg.

    Prefer --text-file for any message with backticks, quotes, newlines, or
    shell metacharacters — it sidesteps shell quoting entirely (same reason
    `gh ... --body-file` is mandated over inline --body).

    `required=False` (used with --blocks-file, where text is just the notification
    fallback) returns "" instead of erroring when no text was supplied."""
    src = getattr(args, "text_file", None)
    if src:
        data = sys.stdin.read() if src == "-" else open(src, encoding="utf-8").read()
        return data.rstrip("\n")
    if args.text is not None:
        return args.text
    if not required:
        return ""
    raise SystemExit("no message text: pass a positional <text> or --text-file <path|->")


def cmd_send(args: argparse.Namespace) -> None:
    blocks_file = getattr(args, "blocks_file", None)
    text = resolve_text(args, required=not blocks_file)
    text = resolve_outbound_mentions(text)  # @handle -> <@id> ping (resolution, not formatting — runs even with --raw)
    if getattr(args, "raw", False):
        # Explicit verbatim opt-out — don't convert, but warn if the text still
        # carries CommonMark that Slack will render literally (the classic ** bug).
        md = looks_like_markdown(text)
        if md:
            print(f"warning: --raw sends verbatim; text contains Markdown "
                  f"({', '.join(md)}) that Slack will render literally. "
                  f"Drop --raw to auto-convert.", file=sys.stderr)
    else:
        text = markdown_to_mrkdwn(text)
    body: dict[str, Any] = {"channel": resolve_channel(args.channel), "text": text}
    if getattr(args, "thread_ts", None):
        body["thread_ts"] = args.thread_ts
    if blocks_file:
        raw = sys.stdin.read() if blocks_file == "-" else open(blocks_file, encoding="utf-8").read()
        try:
            parsed = json.loads(raw)
        except json.JSONDecodeError as e:
            raise SystemExit(f"--blocks-file: invalid JSON: {e}")
        # accept either a bare blocks array or a {"blocks": [...]} wrapper
        blocks = parsed.get("blocks", parsed) if isinstance(parsed, dict) else parsed
        if not isinstance(blocks, list):
            raise SystemExit("--blocks-file: expected a JSON array of Block Kit blocks "
                             "(or an object with a \"blocks\" array)")
        body["blocks"] = blocks
    unfurl = getattr(args, "unfurl", None)
    if unfurl is not None:
        body["unfurl_links"] = unfurl
        body["unfurl_media"] = unfurl
    data = call("chat.postMessage", json_body=body)
    if args.json:
        print(json.dumps(data, indent=2))
    else:
        print(f"posted ts={data['ts']} channel={data['channel']}")


# --- subcommand: search --------------------------------------------------

def cmd_search(args: argparse.Namespace) -> None:
    data = call(
        "search.messages",
        params={
            "query": args.query,
            "sort": "timestamp",
            "sort_dir": "desc",
            "count": args.n,
            "page": args.page,
        },
    )
    if args.json:
        print(json.dumps(data, indent=2))
        return
    rows = []
    for i, m in enumerate(data["messages"]["matches"], 1):
        rows.append([
            f"[{i}]",
            relative_age(m["ts"]),
            f"#{m['channel']['name']}",
            f"@{m.get('username', '?')}",
            truncate(resolve_mentions(m.get("text", "")), 110),
            m.get("permalink", ""),
        ])
    print_table(rows)


# --- subcommand: channels ------------------------------------------------

def cmd_channels(args: argparse.Namespace) -> None:
    chans = list_channels(args.types)  # also warms the persistent name->id cache
    if args.json:
        print(json.dumps(chans, indent=2))
        return
    if args.sort == "popularity":
        chans.sort(key=lambda c: c.get("num_members", 0), reverse=True)
    else:
        chans.sort(key=lambda c: c.get("name") or "")
    rows = []
    for i, c in enumerate(chans[: args.n], 1):
        rows.append([
            f"[{i}]",
            f"#{c.get('name') or c['id']}",
            c["id"],
            str(c.get("num_members", 0)),
            truncate(html.unescape((c.get("purpose") or {}).get("value", "")), 60),
        ])
    print_table(rows)


# --- subcommand: users ---------------------------------------------------

def cmd_users(args: argparse.Namespace) -> None:
    ensure_users_loaded()
    q = args.query.lower()
    hits = [
        (uid, handle, real, USER_EMAIL.get(uid, ""))
        for uid, (handle, real) in USER_CACHE.items()
        if not (handle == uid and real == uid)
        and (q in handle.lower() or q in real.lower() or q in USER_EMAIL.get(uid, "").lower())
    ]
    hits.sort(key=lambda x: x[2].lower())
    if args.json:
        print(json.dumps(
            [{"user_id": u, "handle": h, "real_name": r, "email": e} for u, h, r, e in hits], indent=2))
        return
    rows = [[f"[{i}]", r, f"@{h}", u, e] for i, (u, h, r, e) in enumerate(hits[: args.n], 1)]
    print_table(rows)


# --- subcommand: react ---------------------------------------------------

def cmd_react(args: argparse.Namespace) -> None:
    method = "reactions.remove" if args.remove else "reactions.add"
    data = call(method, json_body={
        "channel": resolve_channel(args.channel),
        "timestamp": args.ts,
        "name": args.emoji.strip(":"),
    })
    if args.json:
        print(json.dumps(data, indent=2))
    else:
        print(f"{'removed' if args.remove else 'added'} :{args.emoji.strip(':')}:")


# --- subcommand: raw -----------------------------------------------------

# Posting methods whose `text` Slack renders as mrkdwn — guarded against
# accidentally shipping un-converted CommonMark through the raw escape hatch.
_RAW_POST_METHODS = {
    "chat.postMessage", "chat.update", "chat.postEphemeral", "chat.scheduleMessage",
}


def cmd_raw(args: argparse.Namespace) -> None:
    """Generic escape hatch: `slack raw <method> k=v k=v ...` (GET) or `--post` (JSON body)."""
    payload = {}
    for kv in args.kv:
        if "=" not in kv:
            raise SystemExit(f"bad k=v pair: {kv}")
        k, v = kv.split("=", 1)
        payload[k] = v
    if args.method in _RAW_POST_METHODS and not getattr(args, "force", False):
        md = looks_like_markdown(payload.get("text", ""))
        if md:
            raise SystemExit(
                f"refusing {args.method}: text contains CommonMark ({', '.join(md)}) "
                f"that Slack renders literally (the classic ** bug).\n"
                f"Use `slack send`/`slack reply` — they auto-convert Markdown→mrkdwn.\n"
                f"To send verbatim anyway, re-run with --force.")
    data = (
        call(args.method, json_body=payload)
        if args.post
        else call(args.method, params=payload)
    )
    print(json.dumps(data, indent=2))


# --- subcommand: file ----------------------------------------------------

def cmd_file(args: argparse.Namespace) -> None:
    info = call("files.info", params={"file": args.file_id})["file"]
    url = info["url_private_download"]
    name = info["name"]

    if args.o == "-":
        out = sys.stdout.buffer
        path = "<stdout>"
    else:
        if args.o is None:
            path = name
        elif os.path.isdir(args.o) or args.o.endswith("/"):
            path = os.path.join(args.o, name)
        else:
            path = args.o
        out = open(path, "wb")

    r = session().get(url, allow_redirects=True, stream=True)
    r.raise_for_status()
    n = 0
    for chunk in r.iter_content(chunk_size=65536):
        out.write(chunk)
        n += len(chunk)
    if out is not sys.stdout.buffer:
        out.close()
    print(f"wrote {path} ({n} bytes)", file=sys.stderr)


# --- subcommand: whoami --------------------------------------------------

def cmd_whoami(args: argparse.Namespace) -> None:
    data = call("auth.test")
    if args.json:
        print(json.dumps(data, indent=2))
    else:
        print(f"user={data['user']} user_id={data['user_id']} team={data['team']} url={data['url']}")


# --- argparse ------------------------------------------------------------

# --- subcommand: style ---------------------------------------------------
#
# Builds a labeled corpus of the token owner's own messages, split by who
# actually typed them. The split is exact, not guessed: Slack tags every
# message posted through the Web API with app_id/bot_id, while a message typed
# in a Slack client carries client_msg_id and neither of those. So "what I
# sound like" (human) is cleanly separable from "what an agent posted as me".
#
# Enumeration goes through search.messages (cheap, complete, and the only way
# to reach thread replies without walking every thread), but search does NOT
# return app_id — only conversations.history/replies do. Hence two passes.
#
# Everything lands under ~/.claude/slack-voice/, never in this repo: the corpus
# is real conversations with real people.

STYLE_DIR = "~/.claude/slack-voice"


def style_dir() -> str:
    d = os.path.expanduser(os.environ.get("SLACK_VOICE_DIR", STYLE_DIR))
    os.makedirs(d, exist_ok=True)
    return d


def provenance(m: dict) -> str:
    """'app' if Slack says an app posted this message, else 'human'."""
    return "app" if (m.get("app_id") or m.get("bot_id")) else "human"


def _search_mine(handle: str, after: str, max_pages: int) -> list[tuple[str, str, str]]:
    """All my messages since `after` as (channel_id, ts, thread_ts|'') triples."""
    out, page = [], 1
    while page <= max_pages:
        data = call("search.messages", params={
            "query": f"from:@{handle} after:{after}",
            "sort": "timestamp", "sort_dir": "desc", "count": 100, "page": page,
        })
        msgs = data["messages"]
        for m in msgs["matches"]:
            link = m.get("permalink", "")
            thread = link.split("thread_ts=", 1)[1].split("&", 1)[0] if "thread_ts=" in link else ""
            out.append((m["channel"]["id"], m["ts"], thread))
        pag = msgs.get("pagination", {})
        print(f"  search page {page}/{pag.get('page_count', '?')} ({len(out)} msgs)", file=sys.stderr)
        if page >= pag.get("page_count", 1):
            break
        page += 1
    return out


def _emit(unit: list[dict], mine: str, seen: set, chan: str, ctype: str, fh) -> int:
    """Walk one conversation unit (thread or history window) and write my messages."""
    unit = sorted(unit, key=lambda m: float(m["ts"]))
    n = 0
    for i, m in enumerate(unit):
        if m.get("user") != mine or m.get("subtype") or not m.get("text", "").strip():
            continue
        key = (chan, m["ts"])
        if key in seen:
            continue
        seen.add(key)
        prev = next((x for x in reversed(unit[:i]) if x.get("user") != mine), None)
        nxt = next((x for x in unit[i + 1:] if x.get("user") != mine), None)
        text = m["text"]
        rec = {
            "ts": m["ts"], "channel": chan, "channel_type": ctype,
            "thread_ts": m.get("thread_ts", ""),
            "provenance": provenance(m),
            "text": text, "chars": len(text),
            "reactions": sum(r.get("count", 0) for r in m.get("reactions", [])),
            "prompt": (prev or {}).get("text", "")[:1500],
            "next": (nxt or {}).get("text", "")[:1500],
            "next_is_question": "?" in (nxt or {}).get("text", ""),
            "reply_latency_s": round(float(nxt["ts"]) - float(m["ts"])) if nxt else None,
        }
        fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
        n += 1
    return n


def cmd_style_scrape(args: argparse.Namespace) -> None:
    mine, handle = me(), auth_info()["user"]
    oldest = time.time() - parse_duration(args.since)
    after = datetime.date.fromtimestamp(oldest).isoformat()
    d = style_dir()
    corpus = os.path.join(d, "corpus.jsonl")

    seen: set = set()
    if not args.full and os.path.exists(corpus):
        with open(corpus) as fh:
            for line in fh:
                r = json.loads(line)
                seen.add((r["channel"], r["ts"]))
        print(f"{len(seen)} messages already in corpus (use --full to rebuild)", file=sys.stderr)

    print(f"enumerating my messages since {after}…", file=sys.stderr)
    targets = _search_mine(handle, after, args.max_pages)
    threads = {(c, t) for c, _, t in targets if t}
    channels = {c for c, _, t in targets if not t}
    print(f"{len(targets)} messages across {len(threads)} threads / {len(channels)} channels",
          file=sys.stderr)

    ctypes = {}
    for c in {c for c, _, _ in targets}:
        ctypes[c] = "im" if c.startswith("D") else "channel"

    written = 0
    with open(corpus, "a") as fh:
        # One unreadable conversation (left channel, archived DM, revoked scope)
        # must not throw away the rest of the scrape — skip it and keep going.
        skipped = 0
        for i, (chan, tts) in enumerate(sorted(threads), 1):
            try:
                data = call("conversations.replies", params={"channel": chan, "ts": tts, "limit": 1000})
            except SystemExit as e:
                print(f"  skip thread {chan}/{tts}: {e}", file=sys.stderr)
                skipped += 1
                continue
            written += _emit(data.get("messages", []), mine, seen, chan, ctypes.get(chan, "channel"), fh)
            if i % 25 == 0:
                print(f"  thread {i}/{len(threads)} ({written} written)", file=sys.stderr)
        for i, chan in enumerate(sorted(channels), 1):
            cursor = ""
            while True:
                params = {"channel": chan, "limit": 200, "oldest": f"{oldest:.6f}"}
                if cursor:
                    params["cursor"] = cursor
                try:
                    data = call("conversations.history", params=params)
                except SystemExit as e:
                    print(f"  skip channel {chan}: {e}", file=sys.stderr)
                    skipped += 1
                    break
                written += _emit(data.get("messages", []), mine, seen, chan,
                                 ctypes.get(chan, "channel"), fh)
                cursor = data.get("response_metadata", {}).get("next_cursor", "")
                if not cursor:
                    break
            print(f"  channel {i}/{len(channels)} ({written} written)", file=sys.stderr)
        if skipped:
            print(f"{skipped} unreadable conversation(s) skipped", file=sys.stderr)

    with open(os.path.join(d, "state.json"), "w") as fh:
        json.dump({"last_run": datetime.datetime.now().isoformat(timespec="seconds"),
                   "since": after, "corpus_size": len(seen)}, fh, indent=2)
    print(f"wrote {written} new records to {corpus} ({len(seen)} total)")


def _load_corpus() -> list[dict]:
    path = os.path.join(style_dir(), "corpus.jsonl")
    if not os.path.exists(path):
        raise SystemExit("no corpus yet — run: slack style scrape")
    with open(path) as fh:
        return [json.loads(line) for line in fh if line.strip()]


def _pct(rows: list[dict], key: str, p: float) -> float:
    vals = sorted(r[key] for r in rows)
    return vals[min(int(len(vals) * p), len(vals) - 1)] if vals else 0


def cmd_style_stats(args: argparse.Namespace) -> None:
    rows = _load_corpus()
    if args.json:
        print(json.dumps(rows, indent=2, ensure_ascii=False))
        return
    buckets = {"human": [r for r in rows if r["provenance"] == "human"],
               "app": [r for r in rows if r["provenance"] == "app"]}
    out = ["# Slack voice: corpus stats", "",
           f"corpus: {len(rows)} of my messages", "",
           "| metric | typed by me | posted by an app |", "|---|---|---|"]

    def col(fn):
        return " | ".join(fn(b) for b in (buckets["human"], buckets["app"]))

    def rate(b, pred):
        return f"{100 * sum(1 for r in b if pred(r)) / len(b):.0f}%" if b else "-"

    out += [
        f"| messages | {col(lambda b: str(len(b)))} |",
        f"| median chars | {col(lambda b: str(_pct(b, 'chars', 0.5)))} |",
        f"| p90 chars | {col(lambda b: str(_pct(b, 'chars', 0.9)))} |",
        f"| >1000 chars | {col(lambda b: rate(b, lambda r: r['chars'] > 1000))} |",
        f"| got a reaction | {col(lambda b: rate(b, lambda r: r['reactions'] > 0))} |",
        f"| drew a follow-up question | {col(lambda b: rate(b, lambda r: r['next_is_question']))} |",
        f"| got no reply at all | {col(lambda b: rate(b, lambda r: r['reply_latency_s'] is None))} |",
    ]
    out += ["", "## Reaction rate by my message length", "", "| length | n | got a reaction |", "|---|---|---|"]
    for lo, hi in [(0, 50), (50, 150), (150, 400), (400, 1000), (1000, 10**9)]:
        b = [r for r in rows if lo <= r["chars"] < hi]
        label = f"{lo}-{hi}" if hi < 10**9 else f"{lo}+"
        out.append(f"| {label} | {len(b)} | {rate(b, lambda r: r['reactions'] > 0)} |")
    out += [
        "", "## Read this honestly",
        "",
        "Engagement columns are observational and badly confounded: app-posted messages were",
        "written for the harder problems and often announce a resolved incident, which attracts",
        "a thumbs-up regardless of length. Do not read the reaction column as evidence either way.",
        "",
        "The length columns are not confounded, and they are the point: the same person writes",
        "two wildly different registers depending on who is typing. That is the gap this profile",
        "closes. The case for the short register rests on the voice being real and on not making",
        "colleagues read machine prose — not on these engagement rates.",
    ]
    text = "\n".join(out)
    print(text)
    with open(os.path.join(style_dir(), "stats.md"), "w") as fh:
        fh.write(text + "\n")


def cmd_style_exemplars(args: argparse.Namespace) -> None:
    rows = [r for r in _load_corpus() if r["provenance"] == "human" and r["chars"] >= args.min_chars]
    seen_text: set = set()
    picked = []
    for r in sorted(rows, key=lambda r: (-r["reactions"], -float(r["ts"]))):
        norm = re.sub(r"\W+", " ", r["text"].lower()).strip()
        if norm in seen_text:
            continue
        seen_text.add(norm)
        picked.append(r)
        if len(picked) >= args.n:
            break
    if args.json:
        print(json.dumps(picked, indent=2, ensure_ascii=False))
        return
    for r in picked:
        if r["prompt"]:
            print(f"--- they said: {truncate(r['prompt'], 300)}")
        print(f"+++ I replied ({r['chars']} chars, {r['reactions']} reactions): {r['text']}")
        print()


def main() -> None:
    p = argparse.ArgumentParser(prog="slack", description=__doc__)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="emit raw JSON")
    sub = p.add_subparsers(dest="cmd", required=True)

    pm = sub.add_parser("mentions", parents=[common], help="recent @mentions of self")
    pm.add_argument("-n", type=int, default=20)
    pm.set_defaults(func=cmd_mentions)

    pd = sub.add_parser("dms", parents=[common], help="recent DMs")
    pd.add_argument("-n", type=int, default=15)
    pd.add_argument("--group", action="store_true", help="include group DMs (mpim)")
    pd.add_argument("--no-resolve", action="store_true", help="skip user-name lookups (fast, raw ids)")
    pd.set_defaults(func=cmd_dms)

    ph = sub.add_parser("history", parents=[common], help="formatted channel timeline (newest first)")
    ph.add_argument("channel", help="C…/D…/G… id, or #name / @user (resolved via cache)")
    ph.add_argument("-n", type=int, default=30)
    ph.add_argument("--since", default=None, metavar="DUR", help="only messages newer than DUR (30m/12h/2d/1w)")
    ph.add_argument("--cursor", default=None, help="next_cursor from a prior page")
    ph.add_argument("--links", action="store_true", help="append a permalink line per message")
    ph.add_argument("--activity", action="store_true", help="include join/leave/topic system messages")
    ph.add_argument("--no-resolve", action="store_true", help="skip name lookups in output (fast, raw ids)")
    ph.add_argument("--warm", action="store_true", help="bulk-prefetch users.list before resolving (busy channels)")
    ph.set_defaults(func=cmd_history)

    pt = sub.add_parser("thread", parents=[common], help="print a thread")
    pt.add_argument("channel", help="C…/D…/G… id, or #name / @user (resolved via cache)")
    pt.add_argument("ts")
    pt.add_argument("-n", type=int, default=50)
    pt.add_argument("--since", default=None, metavar="DUR", help="only replies newer than DUR (30m/12h/2d/1w)")
    pt.add_argument("--cursor", default=None, help="next_cursor from a prior page")
    pt.add_argument("--links", action="store_true", help="append a permalink line per message")
    pt.add_argument("--activity", action="store_true", help="include join/leave/topic system messages")
    pt.add_argument("--no-resolve", action="store_true", help="skip name lookups in output (fast, raw ids)")
    pt.add_argument("--warm", action="store_true", help="bulk-prefetch users.list before resolving (busy threads)")
    pt.set_defaults(func=cmd_thread)

    pr = sub.add_parser("reply", parents=[common], help="reply in a thread")
    pr.add_argument("channel")
    pr.add_argument("thread_ts")
    pr.add_argument("text", nargs="?", help="inline body; omit when using --text-file")
    pr.add_argument("--text-file", metavar="PATH", help="read body from file (or '-' for stdin); preferred for multi-line/backtick text")
    pr.add_argument("--raw", action="store_true", help="send verbatim (skip Markdown→Slack mrkdwn conversion)")
    pr.add_argument("--blocks-file", metavar="PATH", help="JSON Block Kit array (file or '-'); text becomes the notification fallback")
    pr_unfurl = pr.add_mutually_exclusive_group()
    pr_unfurl.add_argument("--unfurl", dest="unfurl", action="store_true", default=None, help="force link/media unfurling")
    pr_unfurl.add_argument("--no-unfurl", dest="unfurl", action="store_false", help="suppress link/media unfurling")
    pr.set_defaults(func=cmd_send)

    ps = sub.add_parser("send", parents=[common], help="send a top-level message")
    ps.add_argument("channel")
    ps.add_argument("text", nargs="?", help="inline body; omit when using --text-file")
    ps.add_argument("--text-file", metavar="PATH", help="read body from file (or '-' for stdin); preferred for multi-line/backtick text")
    ps.add_argument("--raw", action="store_true", help="send verbatim (skip Markdown→Slack mrkdwn conversion)")
    ps.add_argument("--blocks-file", metavar="PATH", help="JSON Block Kit array (file or '-'); text becomes the notification fallback")
    ps_unfurl = ps.add_mutually_exclusive_group()
    ps_unfurl.add_argument("--unfurl", dest="unfurl", action="store_true", default=None, help="force link/media unfurling")
    ps_unfurl.add_argument("--no-unfurl", dest="unfurl", action="store_false", help="suppress link/media unfurling")
    ps.set_defaults(func=cmd_send)

    pq = sub.add_parser("search", parents=[common], help="search messages (slack query syntax)")
    pq.add_argument("query")
    pq.add_argument("-n", type=int, default=20)
    pq.add_argument("--page", type=int, default=1, help="1-based result page (see messages.pagination)")
    pq.set_defaults(func=cmd_search)

    pc = sub.add_parser("channels", parents=[common], help="list channels (warms #name->id cache)")
    pc.add_argument("--types", default="public_channel,private_channel",
                    help="comma list: public_channel,private_channel,mpim,im")
    pc.add_argument("--sort", choices=["name", "popularity"], default="name")
    pc.add_argument("-n", type=int, default=100)
    pc.set_defaults(func=cmd_channels)

    pu = sub.add_parser("users", parents=[common], help="find users by name/handle/email (over cache)")
    pu.add_argument("query")
    pu.add_argument("-n", type=int, default=20)
    pu.set_defaults(func=cmd_users)

    prx = sub.add_parser("react", parents=[common], help="add/remove an emoji reaction")
    prx.add_argument("channel", help="C…/D…/G… id, or #name / @user")
    prx.add_argument("ts")
    prx.add_argument("emoji", help="emoji name, with or without colons (e.g. thumbsup)")
    prx.add_argument("--remove", action="store_true", help="remove instead of add")
    prx.set_defaults(func=cmd_react)

    pr2 = sub.add_parser("raw", parents=[common], help="raw API call: slack raw <method> k=v ...")
    pr2.add_argument("method")
    pr2.add_argument("kv", nargs="*", default=[])
    pr2.add_argument("--post", action="store_true", help="POST as JSON body instead of GET")
    pr2.add_argument("--force", action="store_true", help="bypass the Markdown guardrail on chat.* posting methods")
    pr2.set_defaults(func=cmd_raw)

    pf = sub.add_parser("file", parents=[common], help="download a file by id")
    pf.add_argument("file_id")
    pf.add_argument("-o", help="output path or '-' for stdout (default: file's name in cwd)")
    pf.set_defaults(func=cmd_file)

    pw = sub.add_parser("whoami", parents=[common], help="auth.test result")
    pw.set_defaults(func=cmd_whoami)

    pst = sub.add_parser("style", help="build a corpus of your own writing (see slack-style skill)")
    ssub = pst.add_subparsers(dest="style_cmd", required=True)

    pss = ssub.add_parser("scrape", parents=[common], help="fetch + label your messages")
    pss.add_argument("--since", default="180d", help="how far back (default 180d)")
    pss.add_argument("--full", action="store_true", help="ignore the existing corpus and refetch")
    pss.add_argument("--max-pages", type=int, default=100, help="cap on search pages (100/page)")
    pss.set_defaults(func=cmd_style_scrape)

    pst2 = ssub.add_parser("stats", parents=[common], help="human vs app-posted evidence report")
    pst2.set_defaults(func=cmd_style_stats)

    pse = ssub.add_parser("exemplars", parents=[common], help="dump your best hand-typed messages")
    pse.add_argument("-n", type=int, default=200)
    pse.add_argument("--min-chars", type=int, default=15, help="skip one-word acks below this")
    pse.set_defaults(func=cmd_style_exemplars)

    args = p.parse_args()
    load_caches()
    atexit.register(save_caches)
    args.func(args)


if __name__ == "__main__":
    main()
