def users_list():
    for u in _users():
        click.echo(f"{u['name']:<30} {u.get('email','') or '':<35} {u['id']}")


@cli.group()
def labels():
    """Label operations."""


@labels.command("list")
@click.option("--team", "-t")
def labels_list(team):
    if team:
        t = _team(team)
        rows = [{"id": l["id"], "name": l["name"], "team": t["name"]} for l in t["labels"]["nodes"]]
    else:
        rows = []
        for tm in _teams_meta():
            full = _team_full(tm["id"])
            rows.extend(
                {"id": l["id"], "name": l["name"], "team": full["name"]}
                for l in full["labels"]["nodes"]
            )
    for l in rows:
        click.echo(f"{l['name']:<30} {l.get('team',''):<15} {l['id']}")


