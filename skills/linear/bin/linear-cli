def whoami():
    """Print authenticated user."""
    v = _viewer()
    click.echo(f"{v['name']} <{v['email']}>")
    click.echo(v["id"])


# ---------------------------------------------------------------- search

@cli.group()
def search():
    """Search operations."""


@search.command("issues")
@click.argument("query")
@click.option("--limit", type=int, default=25)
def search_issues(query, limit):
    d = gql(
        f"""
        query($q: String!, $first: Int) {{
          issueSearch(term: $q, first: $first) {{ nodes {{ {ISSUE_FIELDS} }} }}
        }}
        """,
        {"q": query, "first": limit},
    )
    nodes = [_flatten_issue(i) for i in d["issueSearch"]["nodes"]]
    _emit(nodes, "table", None, None, False, False)


@search.command("projects")
@click.argument("query")
@click.option("--limit", type=int, default=25)
def search_projects(query, limit):
    d = gql(
        "query($q: String!, $first: Int) { projectSearch(term: $q, first: $first) { nodes { id name description state } } }",
        {"q": query, "first": limit},
    )
    for p in d["projectSearch"]["nodes"]:
        click.echo(f"{p['name']:<40} {p.get('state','')}")


# ---------------------------------------------------------------- bulk

@cli.group()
def bulk():
    """Bulk operations across multiple issues."""


@bulk.command("update-state")
@click.option("--state", "-s", required=True)
@click.argument("idents", nargs=-1, required=True)
@click.option("--dry-run", is_flag=True)
def bulk_update_state(state, idents, dry_run):
    for i in idents:
        if dry_run:
            click.echo(f"would set {i} -> {state}")
            continue
        cur = gql("query($id: String!) { issue(id: $id) { id team { id } } }", {"id": i})["issue"]
        if not cur:
            click.echo(f"warn: not found: {i}", err=True); continue
        team = _team_full(cur["team"]["id"])
        sid = _resolve_state(team, state)
        d = gql(
            "mutation($id: String!, $input: IssueUpdateInput!) { issueUpdate(id: $id, input: $input) { success } }",
            {"id": cur["id"], "input": {"stateId": sid}},
        )
        click.echo(f"{i}: {'ok' if d['issueUpdate']['success'] else 'failed'}")


@bulk.command("assign")
@click.option("--user", required=True)
@click.argument("idents", nargs=-1, required=True)
@click.option("--dry-run", is_flag=True)
def bulk_assign(user, idents, dry_run):
    uid = _resolve_user(user)
    for i in idents:
        if dry_run:
            click.echo(f"would assign {i} -> {user}"); continue
        cur = gql("query($id: String!) { issue(id: $id) { id } }", {"id": i})["issue"]
        if not cur:
            click.echo(f"warn: not found: {i}", err=True); continue
        d = gql(
            "mutation($id: String!, $input: IssueUpdateInput!) { issueUpdate(id: $id, input: $input) { success } }",
            {"id": cur["id"], "input": {"assigneeId": uid}},
        )
        click.echo(f"{i}: {'ok' if d['issueUpdate']['success'] else 'failed'}")


@bulk.command("unassign")
@click.argument("idents", nargs=-1, required=True)
@click.option("--dry-run", is_flag=True)
def bulk_unassign(idents, dry_run):
    for i in idents:
        if dry_run:
            click.echo(f"would unassign {i}"); continue
        cur = gql("query($id: String!) { issue(id: $id) { id } }", {"id": i})["issue"]
        if not cur:
            click.echo(f"warn: not found: {i}", err=True); continue
        d = gql(
            "mutation($id: String!, $input: IssueUpdateInput!) { issueUpdate(id: $id, input: $input) { success } }",
            {"id": cur["id"], "input": {"assigneeId": None}},
        )
        click.echo(f"{i}: {'ok' if d['issueUpdate']['success'] else 'failed'}")


@bulk.command("label")
@click.option("--add", "add_label")
@click.option("--remove", "remove_label")
@click.argument("idents", nargs=-1, required=True)
@click.option("--dry-run", is_flag=True)
def bulk_label(add_label, remove_label, idents, dry_run):
    if not (add_label or remove_label):
        raise click.ClickException("use --add or --remove")
    for i in idents:
        if dry_run:
            click.echo(f"would change labels on {i}"); continue
        cur = gql(
            "query($id: String!) { issue(id: $id) { id labels(first: 50) { nodes { id name } } team { id } } }",
            {"id": i},
        )["issue"]
        if not cur:
            click.echo(f"warn: not found: {i}", err=True); continue
        team = _team_full(cur["team"]["id"])
        ids = {l["id"] for l in cur["labels"]["nodes"]}
        if add_label:
            ids |= set(_resolve_labels(team, [add_label]))
        if remove_label:
            rm = set(_resolve_labels(team, [remove_label]))
            ids -= rm
        d = gql(
            "mutation($id: String!, $input: IssueUpdateInput!) { issueUpdate(id: $id, input: $input) { success } }",
            {"id": cur["id"], "input": {"labelIds": list(ids)}},
        )
        click.echo(f"{i}: {'ok' if d['issueUpdate']['success'] else 'failed'}")


# ---------------------------------------------------------------- attachments

@cli.group()
def attachments():
    """Attachment listing (read-only convenience)."""


@attachments.command("list")
@click.argument("ident")
def attachments_list(ident):
    d = gql(
